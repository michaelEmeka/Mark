# Normalize text files to LF (Linux-compatible)
* text=auto eol=lf

# Preserve CRLF for Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary files unchanged
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
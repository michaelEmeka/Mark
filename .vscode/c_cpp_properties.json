{
    "configurations": [
        {
            "name": "PlatformIO",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/hardware/embedded/include",
                "${workspaceFolder}/hardware/embedded/src",
                //"${workspaceFolder}/lib/**",
                "C:/Users/USER/.platformio/packages/framework-arduinoespressif32/**",
                "C:/Users/USER/.platformio/packages/toolchain-xtensa-esp32/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ESP32",
                "ESP_PLATFORM"
            ],
            "compilerPath": "C:/Users/USER/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++.exe",
            "intelliSenseMode": "gcc-x86",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${workspaceFolder}/hardware/embedded/include",
                    "${workspaceFolder}/hardware/embedded/src",
                    //"${workspaceFolder}/lib",
                    "C:/Users/USER/.platformio/packages/framework-arduinoespressif32",
                    "C:/Users/USER/.platformio/packages/toolchain-xtensa-esp32"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}